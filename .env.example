# Smart Test Platform - Backend Configuration
# Copy to .env and fill in your values

# DeepSeek API (Required for agent LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Doubao Vision API (Optional, for multimodal - Phase 4)
DOUBAO_API_KEY=

# OpenAI API (Required for GPT-4o multimodal image parsing - Phase 4)
OPENAI_API_KEY=your_openai_api_key_here

# Server
LANGGRAPH_API_URL=http://localhost:2026

# PostgreSQL Database (Phase 8)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_test_platform

# MCP Services
