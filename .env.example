# Smart Test Platform - Backend Configuration
# Copy to .env and fill in your values

# DeepSeek API (Required for agent LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Doubao Vision API (Optional, for multimodal - Phase 4)
DOUBAO_API_KEY=

# OpenAI API (Required for GPT-4o multimodal image parsing - Phase 4)
OPENAI_API_KEY=your_openai_api_key_here

# Server
LANGGRAPH_API_URL=http://localhost:2026

# LightRAG Server Configuration
LIGHTRAG_PORT=9621
LIGHTRAG_LLM_BINDING=openai
LIGHTRAG_LLM_MODEL=deepseek-chat
LIGHTRAG_LLM_BINDING_HOST=https://api.deepseek.com/v1
LIGHTRAG_LLM_BINDING_API_KEY=${DEEPSEEK_API_KEY}
LIGHTRAG_EMBEDDING_BINDING=ollama
LIGHTRAG_EMBEDDING_BINDING_HOST=http://localhost:11434
LIGHTRAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
LIGHTRAG_EMBEDDING_DIM=1024

# MCP Services (Phase 1: configure endpoints, services may not be running yet)
DOCLING_MCP_URL=http://localhost:8976/sse
