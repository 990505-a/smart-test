# Smart Test Platform - Backend Configuration
# Copy to .env and fill in your values

# ===================== 模型 =====================
# 文本模型（对话主模型）—— 任意 OpenAI 兼容端点
# 填了 LLM_BASE_URL 即走该端点；留空使用 DeepSeek 官方 API（回退 DEEPSEEK_*）
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# 模型真实上下文窗口（摘要压缩在 0.85×该值时触发）
LLM_CONTEXT_WINDOW=128000
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=300
# 流式看门狗（秒）：两个 chunk 间最大间隔，思考型模型长推理段可能静默>120s；留空禁用
LLM_STREAM_CHUNK_TIMEOUT=300
# 默认思考强度：留空 | low | medium | high（端点不支持 reasoning_effort 参数时留空）
LLM_REASONING_EFFORT=
# DeepSeek 官方 API（LLM_* 留空时的回退）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# ===================== 服务 =====================
LANGGRAPH_API_URL=http://localhost:5011

# ===================== 用户模块 =====================
AUTH_TOKEN_TTL_HOURS=72
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=admin123

# ===================== 飞书集成 (lark-cli) =====================
LARK_CLI_BIN=lark-cli
LARK_CLI_IDENTITY=user
# 用例生成结果保存的默认思维导图 ID（在飞书思维笔记 URL 中获取）
FEISHU_MINDNOTE_ID=
FEISHU_MINDNOTE_PARENT_NODE=
# 导图样式模板（直线连线）：在飞书建一张调好样式、只留根节点的干净导图，
# 把其 URL 中的 mindnote token 填到这里；导出 = 复制模板 + 写入用例树。
# 留空回退 OPML 导入（飞书默认曲线样式）
FEISHU_TEMPLATE_MINDNOTE_ID=

# ===================== RAG 模块 (LightRAG) =====================
# 服务由启动器(:5010)按**知识库注册表**拉起：一个知识库 = 一个实例 + 一个
# workspace（数据互不可见），清单在 workspace/<space>/rag_kbs.json。
# 界面入口：LightRAG 自带 WebUI 里的「RAG 设置」页（启动器注入，见 tools/lightrag-ui），
# 平台侧对应 /rag 页（只做展示与检索验证）。
#
# LIGHTRAG_BASE_URL 只在注册表文件还没落盘时生效（当默认库的地址种子）。
LIGHTRAG_BASE_URL=http://127.0.0.1:5014
# 所有库共用这个工作目录，各自的 workspace 是它下面的子目录：
#   workspace/default/rag/<workspace>/kv_store_*.json
LIGHTRAG_WORKING_DIR=workspace/default/rag
# LLM 绑定（入库时的实体抽取 + 需要生成的检索）。三个都留空 = 跟随平台主模型
# （LLM_BASE_URL / LLM_MODEL / LLM_API_KEY）。⚠️ 别只改 base_url 不改 key：
# 曾经写死 api.deepseek.com 却配着别家的 key，入库一律 401，而知识库当时是空的、
# 没人发现。改完要在「RAG 设置」页点「保存并重启」，或重启对应实例。
LIGHTRAG_LLM_BASE_URL=
LIGHTRAG_LLM_MODEL=
LIGHTRAG_LLM_API_KEY=
# Embedding 走 OpenAI 兼容 API（默认硅基流动 bge-m3，免费额度即可；
# 本机 MLX 版示例：http://127.0.0.1:7997/v1 + mlx-community/bge-m3-mlx-fp16）
# 维度必须与模型一致（bge-m3 = 1024）：改了维度旧向量检不出来，需要重新入库。
LIGHTRAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LIGHTRAG_EMBEDDING_MODEL=BAAI/bge-m3
LIGHTRAG_EMBEDDING_API_KEY=
LIGHTRAG_EMBEDDING_DIM=1024

# ===================== 代码图谱模块 =====================
# 官方 codebase-memory-mcp（https://github.com/DeusData/codebase-memory-mcp）。
# 一个二进制同时提供三种用法：stdio MCP（agent 工具）/ `cli <tool>` 一锤子调用
# （平台的索引与查询）/ `--ui=true` HTTP 图服务（:9749，图可视化数据源）——
# 旧的双 exe（GS 定制版索引 + 官方版出图）自 v0.11.0 起已废弃。
#
# 留空 = 用平台自管安装位置 tools/codebase-memory/：「代码图谱」页可一键安装/升级，
# 平台按当前系统下载官方 release 并校验 sha256（Windows/macOS/Linux 均有官方构建）。
# 装在别处再填绝对路径覆盖。
CODEBASE_MEMORY_EXE=
# 平台自管安装的目标版本（release tag）；升降级改这里后点页面上的「升级」
CODEBASE_VERSION=v0.11.0
# exe 内置 HTTP 图服务端口（按需自动拉起）
CODEBASE_GRAPH_PORT=9749
# 定时增量索引（间隔制；只增量已建库仓库，配置也可在 /codebase 页「定时任务」Tab 修改）
CODEBASE_SCHEDULE_ENABLED=True
CODEBASE_INTERVAL_HOURS=24
# 索引后的「增量影响分析」：无头跑 codebase_agent 分析本轮变更的影响面。
# 会消耗 token 且需要 LangGraph 服务在线，故默认关闭（另需每个仓库开启「参与影响分析」）
CODEBASE_ANALYZE_ENABLED=False

# ===================== 外部依赖快速失败 =====================
# 连续失败 N 次后，冷却 T 秒内直接返回失败，不再等满超时（LightRAG 120s / 代码图谱 45s）。
# 只挂短查询类调用；全量索引这类长任务不受影响。CIRCUIT_BREAKER_FAIL_MAX=0 关闭熔断。
# 平台不做自动重试：工具失败一律交回模型判断（理由见 middleware/run_guards.py）。
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=30

# ===================== Unity 自动化模块 =====================
# 通用桥：标准 MCP。Unity 工程里装「MCP for Unity」包（CoplayDev/unity-mcp，MIT），
# 由它连到这里的 MCP 服务器；平台经 MCP 操作 Unity（对象查询 / 编辑器控制 / 任意 C#）。
# 启动器里的 unity-mcp 服务默认按 UNITY_MCP_URL 的端口（5016）用 uvx 拉起官方服务器。
UNITY_MCP_URL=http://127.0.0.1:5016/mcp
# http | stdio —— stdio 用于"只能本地以命令拉起服务器"的场合，需要 UNITY_MCP_COMMAND
UNITY_MCP_TRANSPORT=http
# stdio 模式的启动命令（留空 = uvx --from mcpforunityserver==10.2.0 mcp-for-unity --transport stdio）
# 版本要跟 Unity 工程里「MCP for Unity」包版本一致（插件也按插件版本钉同一个 PyPI 包）
UNITY_MCP_COMMAND=
# 工具名方言：auto 按服务器自报名识别；认不准时手工指定 coplay | ivan | generic
UNITY_MCP_SERVER=auto

# ===================== 记忆模块 (Markdown 记忆 / harness 风格) =====================
# 记忆 = workspace/<space>/memory/ 下的一组 Markdown（AGENTS.md 工作区指令 /
# MEMORY.md 长期记忆 / USER.md 用户画像 / failures.md 失败教训 / PROJECT.md 项目
# 上下文 / DECISIONS.md 决策记录，外加用户自建模块）。
# 平台首次启动自动落盘种子文件；每个模块可在「Agent 记忆」页单独启用/停用与编辑。
# 这里只有总开关（false = 完全不向提示词注入记忆）。
MEMORY_ENABLED=True

# ===================== 接口自动化模块 =====================
API_SCRIPT_WORKSPACE=
API_SCRIPT_PYTHON=python
API_AUTO_MAX_REPAIR=3

# ===================== 测评（智能体测评 / Langfuse） =====================
# 测评用的 Langfuse（跑评测集：trace + 分数 + DatasetRun 上报到这里）
LANGFUSE_ENABLED=True
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=eval
# 缺省回退主 LLM（这三项留空 = 继承 LLM_*），建议另配一个模型做裁判
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# ===================== 监控（日常智能体使用链路 / Langfuse） =====================
# 日常对话的 trace 上报到**监控组织**的 Langfuse，与上面的测评 Langfuse 分开：
# 日常排查看监控，跑测评时只看测评。留空 / false = 不上报。
LANGFUSE_MONITOR_ENABLED=false
LANGFUSE_MONITOR_BASE_URL=
LANGFUSE_MONITOR_PUBLIC_KEY=
LANGFUSE_MONITOR_SECRET_KEY=
LANGFUSE_MONITOR_ENVIRONMENT=monitor
